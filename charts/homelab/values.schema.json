{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "homelab chart values",
  "type": "object",
  "required": [
    "secrets",
    "config",
    "syncWaves",
    "api",
    "worker",
    "web",
    "postgres",
    "redis",
    "qdrant",
    "pushgateway",
    "prometheus",
    "grafana",
    "mlflow",
    "ingress"
  ],
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          },
          "description": "Pinned tag; 'latest' is rejected."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    }
  },
  "properties": {
    "secrets": {
      "type": "object",
      "required": [
        "existingSecret"
      ],
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Name of a Secret created out of band. The chart never renders secret values."
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "properties": {
        "LLM_BACKEND": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "auto"
          ]
        }
      }
    },
    "syncWaves": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "storageClass": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "waitForPostgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "api": {
      "type": "object",
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "web": {
      "type": "object",
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        },
        "initScripts": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        }
      }
    },
    "qdrant": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        }
      }
    },
    "pushgateway": {
      "type": "object",
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        }
      }
    },
    "prometheus": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$"
        },
        "configOverride": {
          "type": "string"
        }
      }
    },
    "grafana": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        }
      }
    },
    "mlflow": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "array"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "service",
                    "port"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "service": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
