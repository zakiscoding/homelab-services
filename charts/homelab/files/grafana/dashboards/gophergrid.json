{
  "uid": "gophergrid",
  "title": "GopherGrid",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Throughput (jobs/s)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gophergrid_jobs_finished_total{status=\"succeeded\"}[1m]))",
          "instant": false
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Queued",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(gophergrid_queue_depth * on(instance) group_left gophergrid_is_leader)",
          "instant": false
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Running",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(gophergrid_running_jobs * on(instance) group_left gophergrid_is_leader)",
          "instant": false
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Workers alive",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(gophergrid_workers_alive * on(instance) group_left gophergrid_is_leader)",
          "instant": false
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Queue latency p95",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gophergrid_queue_latency_seconds_bucket[1m])))",
          "instant": false
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Leader",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (gophergrid_is_leader) == 1",
          "instant": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Throughput by type",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(gophergrid_jobs_finished_total{status=\"succeeded\"}[1m]))",
          "legendFormat": "{{type}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gophergrid_jobs_submitted_total[1m]))",
          "legendFormat": "submitted"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Queue depth by priority band",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": true,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (band) (gophergrid_queue_depth * on(instance) group_left gophergrid_is_leader)",
          "legendFormat": "{{band}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Queue latency (submit to first assignment)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gophergrid_queue_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gophergrid_queue_latency_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gophergrid_queue_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Task failures and retries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(gophergrid_task_failures_total[1m]))",
          "legendFormat": "failure: {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(gophergrid_requeues_total[1m]))",
          "legendFormat": "requeue: {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(gophergrid_stale_completions_total[1m]))",
          "legendFormat": "stale completion rejected"
        },
        {
          "refId": "D",
          "expr": "sum(increase(gophergrid_dead_workers_total[1m]))",
          "legendFormat": "workers declared dead"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Worker utilization (reserved CPU)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gophergrid_worker_utilization{resource=\"cpu_reserved\"} * on(instance) group_left gophergrid_is_leader",
          "legendFormat": "{{worker}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Worker utilization (measured CPU)",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gophergrid_worker_utilization{resource=\"cpu_used\"} * on(instance) group_left gophergrid_is_leader",
          "legendFormat": "{{worker}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Scheduling pass and delivery latency",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gophergrid_scheduling_pass_seconds_bucket[1m])))",
          "legendFormat": "pass p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gophergrid_assignment_delivery_seconds_bucket[1m])))",
          "legendFormat": "assignment delivery p95"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Autoscaler",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gophergrid_autoscaler_desired_workers",
          "legendFormat": "desired"
        },
        {
          "refId": "B",
          "expr": "gophergrid_autoscaler_current_workers",
          "legendFormat": "current"
        }
      ],
      "id": 14
    }
  ],
  "tags": [
    "gophergrid"
  ]
}
