# Copy to .env (never commit .env)
GPU_URL=http://100.88.71.33:11434

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=homelab

API_KEY=change-me-long-random-string

# GPU worker (zak_pc) calls iMac internal job endpoints
WORKER_API_KEY=change-me-worker-key-different-from-api-key

# Phase 4 — LPUSH wake queues on job create/requeue (Postgres still SSOT)
JOB_NOTIFY_ENABLED=true

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Public internet (your domain + router port-forward 80/443 → iMac)
# Run: ./scripts/hash-web-password.sh 'your-password'  then paste hash below
# DOMAIN=ml.example.com          ← replace example.com with a domain you own
# ACME_EMAIL=you@example.com
# WEB_AUTH_USER=admin
# WEB_AUTH_HASH='$2a$14$...'     ← single quotes required (hash contains $)
