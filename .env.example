# Copy to .env (never commit .env)
GPU_URL=http://100.88.71.33:11434

# LLM backend for /chat and /rag/query:
#   ollama -> Ollama at GPU_URL (GPU PC booted into Windows)
#   openai -> vLLM / any OpenAI-compatible server at LLM_URL (GPU PC booted into Ubuntu,
#             gpu-systems-lab/serving/compose.yml)
LLM_BACKEND=ollama
LLM_URL=http://100.121.51.35:8000/v1
# must equal VLLM_API_KEY in gpu-systems-lab/serving/.env on the GPU node
LLM_API_KEY=change-me
LLM_DEFAULT_MODEL=qwen2.5-1.5b-instruct
LLM_MAX_TOKENS=1024
# Reaction CNN inference (homelab-gpu reaction/serve.py on zak_pc)
GPU_VISION_URL=http://100.88.71.33:8100
# Optional — must match REACTION_SERVE_KEY on GPU if set
REACTION_SERVE_KEY=

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=homelab

API_KEY=change-me-long-random-string

# GPU worker (zak_pc) calls iMac internal job endpoints
WORKER_API_KEY=change-me-worker-key-different-from-api-key

# Phase 4 — LPUSH wake queues on job create/requeue (Postgres still SSOT)
JOB_NOTIFY_ENABLED=true

# MLflow tracking UI (docker-compose mlflow service; uses Postgres DB "mlflow")
# GPU training sets MLFLOW_TRACKING_URI=http://<imac-tailscale>:5001
# MLFLOW_PORT=5001

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Optional — public HTTPS only if you add a domain later (most setups use Tailscale/LAN only)
# DOMAIN=ml.example.com
# ACME_EMAIL=you@example.com
# WEB_AUTH_USER=homelab
# WEB_AUTH_HASH='$2a$14$...'
