{
  "uid": "gpu-node",
  "title": "GPU node (RTX 5070, zak-gpu-node)",
  "tags": [
    "gpu",
    "dcgm"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gpu-node-prom"
        },
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL, gpu)",
          "refId": "gpu"
        },
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL, gpu)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "GPU now",
      "id": 1,
